{
  "manifest_version": 3,
  "name": "Daily Tab",
  "version": "0.1.0",
  "description": "Opens Daily Tab on every new tab.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": ["https://daily-tab.vercel.app/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
