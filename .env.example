# Runtime connection. Local: the shared Supabase stack (127.0.0.1:54322).
# Prod (Vercel): Supabase transaction pooler, port 6543.
DATABASE_URL=

# Optional. Connection used by drizzle-kit migrations; falls back to DATABASE_URL.
# Prod: Supabase session pooler (port 5432) or direct connection.
DATABASE_URL_MIGRATE=

# Optional locally, required for integration tests: separate database `daily_tab_test`.
TEST_DATABASE_URL=

# Login (see README "Authentication"). Use your own values; never commit them.
# Digits only, at least 6.
AUTH_PIN=
# At least 32 characters: openssl rand -base64 32. Changing it logs out every device.
AUTH_SECRET=
